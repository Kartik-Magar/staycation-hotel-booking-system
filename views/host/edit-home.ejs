<%- include('../partials/head') %>
</head>
<body class="bg-gradient-to-br from-blue-300 via-white to-gray-500 min-h-screen flex flex-col items-center min-h-screen">

    <%- include('../partials/nav') %>

    <header class="mt-10">
        <h1 class="text-3xl font-bold text-yellow-500"><%= editing ? "Edit" : "Register"%> Your Home</h1>
    </header>

    <main class="mt-8 w-full max-w-lg bg-white p-6 rounded-lg shadow-lg border border-red-300">
        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="post" enctype="multipart/form-data" class="space-y-4">
            <div>
                <input type="hidden" name ="id" value="<%= editing ? home._id : '' %>">
                <!-- <label for="houseName" class="block text-lg font-medium text-gray-700">House Name:</label> -->
                <input 
                    type="text" 
                    name="houseName" 
                    value="<%= editing ? home.houseName : ''%>"
                    id="houseName" 
                    placeholder="Enter House Name here"
                    class="mt-1 w-full p-3 border rounded-lg focus:ring-2 focus:ring-red-400 focus:outline-none"
                    required
                >
                <!-- <label for="pricePerNight" class="block text-lg font-medium text-gray-700">Price Per Night:</label> -->
                <input 
                    type="text" 
                    name="price" 
                    value="<%= editing ? home.price : '' %>"
                    id="pricePerNight" 
                    placeholder="Enter Price"
                    class="mt-1 w-full p-3 border rounded-lg focus:ring-2 focus:ring-red-400 focus:outline-none"
                    required
                >
                <input 
                    type="number" max="5" min="0" step="0.1"
                    name="rating" 
                    value="<%= editing ? home.rating : ''%>"
                    id="rating" 
                    placeholder="Rating"
                    class="mt-1 w-full p-3 border rounded-lg focus:ring-2 focus:ring-red-400 focus:outline-none"
                    required
                >
                <input 
                    type="text" 
                    name="location" 
                    value="<%= editing ? home.location : ''%>"
                    id="location" 
                    placeholder="Enter location"
                    class="mt-1 w-full p-3 border rounded-lg focus:ring-2 focus:ring-red-400 focus:outline-none"
                    required
                >
                <input 
                    type="file" 
                    name="photo" 
                    accept="image/*jpg, image/ipeg, image/png"
                    multiple
                    id="photo" 
                    class="mt-1 w-full p-3 border rounded-lg focus:ring-2 focus:ring-red-400 focus:outline-none"
                    
                > 
                <textarea  
                name="description"
                id="description"
                placeholder="Enter description here"
                class="mt-1 w-full p-3 border rounded-lg focus:ring-2 focus:ring-red-400 focus:outline-none"
              ><%= editing ? home.description : '' %></textarea>
              
            </div>

            <button 
                type="submit"
                class="w-full bg-red-500 text-white py-2 px-4 rounded-lg font-bold text-lg hover:bg-red-700 transition"
            >
             <%= editing ? 'Update home' : 'Add Home'%>
            </button>
        </form>
    </main>

</body>
</html>
