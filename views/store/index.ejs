<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>StayCation - Luxury Vacation Rentals</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .text-glow { text-shadow: 0 0 10px rgba(255, 255, 255, 0.7); }
    .bg-overlay { background-color: rgba(0, 0, 0, 0.3); }
    .bg-overlay-light { background-color: rgba(255, 255, 255, 0.1); }
    .smooth-transition { transition: all 0.4s ease; }
    .brightness-hover:hover { filter: brightness(1.2); }
    .bg-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh; /* Ensure the height covers the full screen */
  background-size: cover;
  background-position: center;
  opacity: 0;
  animation: bgCycle 15s infinite;
  transition: opacity 2s ease-in-out, transform 2s ease-in-out;
}
    .bg-slide:nth-child(1) { background-image: url('/uploads/bg3.jpeg'); animation-delay: 0s; }
    .bg-slide:nth-child(2) { background-image: url('/uploads/bghouse1.jpg'); animation-delay: 5s; }
    .bg-slide:nth-child(3) { background-image: url('/uploads/bghouse2.jpg'); animation-delay: 10s; }

    @keyframes bgCycle {
      0%, 100% { opacity: 0; transform: scale(1.05); }
      10%, 30% { opacity: 1; transform: scale(1); }
      40% { opacity: 0; transform: scale(1.02); }
    }
  </style>
</head>
<body class="relative text-white min-h-screen overflow-x-hidden">

