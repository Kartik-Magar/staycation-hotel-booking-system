  <!-- Hidden logout form -->
  <form id="logoutForm" action="/logout" method="POST" style="display: none;"></form>

  <!-- Role Switch Modal -->
  <div id="roleModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-white text-black rounded-xl shadow-2xl p-6 max-w-md w-full relative">
      <h2 class="text-2xl font-semibold mb-4">Want to Switch Account ?</h2>
      <p id="modalMessage" class="mb-6 text-gray-700">Are you sure you want to switch roles?</p>
      <div class="flex justify-end gap-4">
        <button onclick="closeModal()" class="px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300">Cancel</button>
        <button onclick="confirmSwitch()" class="px-4 py-2 rounded-lg bg-yellow-400 hover:bg-yellow-500 text-black font-semibold">Yes, Continue</button>
      </div>
      <button onclick="closeModal()" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700">✕</button>
    </div>
  </div>

  <!-- JavaScript for role switching -->
  <script>
    let redirectAfterConfirm = "";

    function handleRoleSwitch(currentRole, redirectUrl) {
      const isGuest = currentRole === "guest";
      const message = isGuest
        ? "To become a host, you need to switch roles. Logout and continue?"
        : "To explore homes, you need to switch to a guest account. Logout and continue?";

      document.getElementById("modalMessage").innerText = message;
      redirectAfterConfirm = redirectUrl;
      document.getElementById("roleModal").classList.remove("hidden");
    }

    function closeModal() {
      document.getElementById("roleModal").classList.add("hidden");
      redirectAfterConfirm = "";
    }

    function confirmSwitch() {
      const form = document.getElementById("logoutForm");
      const input = document.createElement("input");
      input.type = "hidden";
      input.name = "redirectTo";
      input.value = redirectAfterConfirm;
      form.appendChild(input);
      form.submit();
    }
    document.querySelector('a[href="#contact-us"]').addEventListener('click', function(e) {
    e.preventDefault();
    document.querySelector('#contact-us').scrollIntoView({
      behavior: 'smooth'
    });
  });
  </script>
