<%- include('../partials/head') %>

</head>

<body class="bg-gradient-to-br from-blue-300 via-white to-gray-500 min-h-screen py-0 flex flex-col min-h-screen">

  <%- include('../partials/nav') %>

      
      <script src="https://cdn.tailwindcss.com"></script>
      

      <main class="flex-grow flex items-center justify-center p-6">
        <div class="text-center">
          <h1 class="text-5xl font-bold text-gray-700">
            Welcome to <span class="text-yellow-500">StayCation</span>
          </h1>
          <h2 class="text-2xl font-semibold mt-3 text-gray-500">
            Here are our registered homes:
          </h2>
      
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6 w-full max-w-6xl">
            <% registerHomes.forEach(home => { %>
              <li class="bg-white shadow-lg rounded-lg overflow-hidden border border-red-300 hover:scale-110 transition duration-300 ease-in-out">
                <img src="/<%= home.photo %>" alt="House Image" class="w-full h-48 object-cover">
                <div class="p-5 text-center bg-[#bg-[#FBFBFB]] bg-opacity-85 hover:cursor-pointer">
                  <h2 class="text-2xl font-bold text-yellow-400"><%= home.houseName %></h2>
                  <p class="text-gray-800 mt-2">🌎 Location: <span class="font-semibold"><%= home.location %></span></p>
                  <p class="text-gray-800 mt-1">⭐ Rating: <span class="font-semibold"><%= home.rating %></span>/5</p>
                  <p class="text-gray-800 mt-1">💰 Price: <span class="font-semibold text-red-400">₹ <%= home.price %></span> per night</p>
                  <a href="/homes/<%= home._id %>" class="mt-4 inline-block bg-green-900 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition">Details</a>
                  <a href="/book/<%= home._id %>" class="mt-4 inline-block bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition">Book Now</a>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </main>
      
    

</body>
</html>
