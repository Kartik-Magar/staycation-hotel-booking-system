<%- include('../partials/head') %>
</head>
<body class="bg-gradient-to-br from-blue-300 via-white to-gray-500 min-h-screen py-0 flex flex-col">
    <%- include('../partials/nav') %>


    <main class="flex-grow flex flex-col items-center justify-center p-5">
        <h1 class="text-4xl font-bold text-gray-700 text-center mb-10">Here are our favourite homes:</h1>

        <div class="flex flex-wrap justify-center gap-6 ">
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6 max-w-6xl mx-auto justify-items-center">
                <% favouriteHomes.forEach(home => { %>
                    <li class="bg-white shadow-lg rounded-lg overflow-hidden border border-red-300 w-80 hover:scale-110 transition duration-300 ease-in-out">
                        <!-- House Image -->
                        <img src="/<%= home.photo %>" alt="House Image" class="w-full h-48 object-cover">
                        
                        <!-- Card Content -->
                <div class="p-5 text-center bg-[#1B1B1B] bg-opacity-85 hover:cursor-pointer">
                    <h2 class="text-2xl font-bold text-yellow-400"><%= home.houseName %></h2>
                    <p class="text-gray-100 mt-2">🌎 Location: <span class="font-semibold"><%= home.location %></span></p>
                    <p class="text-gray-100 mt-1">⭐ Rating: <span class="font-semibold"><%= home.rating %></span>/5</p>
                    <p class="text-gray-100 mt-1">💰 Price: <span class="font-semibold text-red-400">₹ <%= home.price %></span> per night</p>
                            
            <form action="/favourites/delete/<%= home._id%>" method="post">
                <a href="/homes/<%= home._id %>" class="mt-4 inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition mr-2">Details</a>
                <button type="submit" class="mt-4 inline-block bg-blue-800 hover:bg-blue-900 text-white font-bold py-2 px-4 rounded-lg transition">Remove</button>
            </form>
                        </div>
                    </li>
                <% }) %>
            </ul>
        </div>
    </main>

</body>
</html>
